{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompactEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --staged)",
      "Bash(git diff --cached)",
      "Bash(git log --oneline)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(ruff format --check)",
      "Bash(ruff format --check .)"
    ]
  }
}
