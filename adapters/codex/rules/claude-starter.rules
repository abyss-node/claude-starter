# claude-starter: read-only commands Codex may run without asking.
# Generated by scripts/build_adapters.py. Codex matches `pattern` against a PREFIX of the
# command (anything may follow it), so a command is allowed here only after it was checked
# with arguments appended and none of them made it write. Left out:
#   git diff: left out, `git diff --output=<file>` writes a file
#   git diff --stat: left out, `--output=<file>` writes a file
#   git diff --staged: left out, `--output=<file>` writes a file
#   git diff --cached: left out, `--output=<file>` writes a file
#   git log --oneline: left out, `--output=<file>` writes a file
#   git branch: left out, `git branch <name>` creates a branch and `-D` deletes one
#   ruff format --check: left out, `--cache-dir <dir>` writes a cache directory wherever it points
#   ruff format --check .: left out, `--cache-dir <dir>` writes a cache directory wherever it points
# Codex checks match/not_match when it loads this file. Test it offline with:
#   codex execpolicy check --rules <this file> -- git status

prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "read-only command (claude-starter)",
    match = ["git status"],
    not_match = ["git stash"],
)

prefix_rule(
    pattern = ["git", "branch", "--show-current"],
    decision = "allow",
    justification = "read-only command (claude-starter)",
    match = ["git branch --show-current"],
    not_match = ["git branch -D main"],
)
